# 复制为 .env 后填写。该文件含密钥，不要提交到公开仓库。

# 对外访问地址（带协议，不带结尾斜杠）
# 例：https://sheet.doorsgame.wiki
APP_HOME_URL=https://sheet.example.com

# 单组织标识，随便取一个短名，例如 doorswiki
GRIST_SINGLE_ORG=doorswiki

# 会话签名密钥，用 `openssl rand -hex 32` 生成
GRIST_SESSION_SECRET=change-me

# Nginx Basic Auth 用户名即邮箱，认证后通过此请求头交给 Grist
GRIST_LOGIN_SYSTEM_TYPE=forward-auth
GRIST_FORWARD_AUTH_HEADER=X-Forwarded-User
GRIST_IGNORE_SESSION=true
GRIST_FORCE_LOGIN=true
GRIST_IN_SERVICE=true

TZ=Asia/Shanghai
