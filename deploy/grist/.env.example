# 复制为 .env 后填写。该文件含密钥，不要提交到公开仓库。

# 对外访问地址（带协议，不带结尾斜杠）
# 例：https://sheet.doorsgame.wiki
APP_HOME_URL=https://sheet.example.com

# 单组织标识，随便取一个短名，例如 doorswiki
GRIST_SINGLE_ORG=doorswiki

# 会话签名密钥，用 `openssl rand -hex 32` 生成
GRIST_SESSION_SECRET=change-me

# 首个管理员的邮箱
GRIST_DEFAULT_EMAIL=admin@example.com

TZ=Asia/Shanghai
